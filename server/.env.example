# Paystack TEST secret key (sk_test_…). The server refuses to start charges with a live key.
PAYSTACK_SECRET_KEY=
# Google Maps Platform key with Places API (New) and Routes API enabled.
GOOGLE_MAPS_API_KEY=
# Shared secret Chord sends as `Authorization: Bearer …` (set as auth_token when registering the MCP server).
MCP_BEARER_TOKEN=
# Optional: 1 logs the headers and MCP _meta of each tool call, secrets redacted.
LOG_REQUEST_CONTEXT=0
PORT=3000
